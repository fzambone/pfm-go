            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/households/{{household_id}}/accounts/{{account_id}}/balance",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "households", "{{household_id}}", "accounts", "{{account_id}}", "balance"]
